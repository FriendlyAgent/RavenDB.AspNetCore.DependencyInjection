# Auto detect text files and perform LF normalization
* text=auto

# C# source files
*.cs text diff=csharp

# Project and solution files
*.sln text eol=crlf
*.csproj text eol=crlf

# Shell scripts
*.sh text eol=lf

# Images
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
